{
  "name": "jt-blog",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "content:sync": "turbo run sync --filter=@jt-blog/notion-sync",
    "content:sync:mock": "turbo run sync:mock --filter=@jt-blog/notion-sync",
    "content:schedule:install": "turbo run schedule:install --filter=@jt-blog/notion-sync",
    "dev": "turbo run dev --filter=@jt-blog/blog",
    "lint": "turbo run lint",
    "prepare": "simple-git-hooks",
    "preview": "turbo run preview --filter=@jt-blog/blog",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-solid": "catalog:", 
    "eslint-plugin-react-refresh": "catalog:",
    "lint-staged": "catalog:",
    "simple-git-hooks": "catalog:",
    "turbo": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}

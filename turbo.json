{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "node_modules/.tmp/*.tsbuildinfo"]
    },
    "check-types": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "schedule:install": {
      "cache": false,
      "env": ["NOTION_SYNC_ENV_FILE"]
    },
    "sync": {
      "cache": false,
      "env": [
        "NOTION_DATA_SOURCE_ID",
        "NOTION_DESCRIPTION_PROPERTY",
        "NOTION_PUBLISHED_PROPERTY",
        "NOTION_PUBLISHED_VALUE",
        "NOTION_SLUG_PROPERTY",
        "NOTION_STATUS_PROPERTY",
        "NOTION_SYNC_ENV_FILE",
        "NOTION_SYNC_OUTPUT_DIR",
        "NOTION_TAGS_PROPERTY",
        "NOTION_TITLE_PROPERTY",
        "NOTION_TOKEN"
      ]
    },
    "sync:mock": {
      "cache": false
    },
    "test": {
      "dependsOn": ["check-types"],
      "outputs": []
    }
  }
}

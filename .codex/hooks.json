{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "command": "pnpm --dir \"$(git rev-parse --show-toplevel)\" exec tsx .codex/hooks/jt-ai-hook/pre-tool-use.ts codex",
            "statusMessage": "Tracking AI edit",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "command": "pnpm --dir \"$(git rev-parse --show-toplevel)\" exec tsx .codex/hooks/jt-ai-hook/post-tool-use.ts codex",
            "statusMessage": "Recording AI-edited files",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "pnpm --dir \"$(git rev-parse --show-toplevel)\" exec tsx .codex/hooks/jt-ai-hook/stop-entry.ts codex",
            "statusMessage": "Running AI checks",
            "timeout": 150,
            "type": "command"
          }
        ]
      }
    ]
  }
}
